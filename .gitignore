# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 비밀값 · 환경별 설정 (키, IP·포트 등) — 항목은 .env.example 참고 ──
.env
.env.*
!.env.example
.envrc
secrets/
*.key
*.pem
credentials*.json

# ── 환경 ───────────────────────────────────────
.venv/
venv/
.vscode/
.idea/

# ── 데이터 (공개 불가 · 용량) — 사용 데이터셋은 README.md 참조 ──
data/

# ── 학습 산출물 · 캐시 (체크포인트, 병합 모델, KB 임베딩 캐시) ──
models/

# ── 문서 · 결과 · 발표 자료 (GitHub에는 코드만) ──
qa_docs/

