# 환경별 설정 · 비밀값. 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git 제외).
#   cp .env.example .env
# 셸에 이미 설정된 환경변수가 .env 보다 우선한다.

# ── 비밀값 ──
# NCPMS OpenAPI 키 (https://ncpms.rda.go.kr/npms/OpenApiInfo.np) — data_prep/ncpms_collect.py 에서 사용
NCPMS_API_KEY=

# ── 플랫폼 서버 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=5100

# ── 답변 문장 다듬기 (Ollama) ──
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b

# ── 학습 · 측정 (train/train.py, eval/run_eval_9b.py) ──
# HF_HOME=/path/to/hf_cache
# LLAMAFACTORY_DIR=/path/to/LLaMA-Factory
# CUDA_VISIBLE_DEVICES=0
